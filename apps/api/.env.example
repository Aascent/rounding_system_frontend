# Copy to apps/api/.env for local development. Never commit real values.
NODE_ENV=development
PORT=3001
SERVICE_VERSION=0.1.0
ALLOWED_ORIGINS=http://localhost:3000
# Demo dataset and local accounts (seeded on first start).
DATA_MODE=synthetic
AUTH_MODE=local
# Use a real PostgreSQL (e.g. your local PostgreSQL 18 or Cloud SQL):
# DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/smart_rounding
# Without DATABASE_URL an embedded PostgreSQL keeps its files here:
PGLITE_DATA_DIR=.data/pglite
# Session policy placeholders (pending the practice's decision).
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
SESSION_REMEMBER_DAYS=7
# Demo-only: password for the seeded accounts and the stand-in MFA code.
SEED_DEMO_PASSWORD=Demo123!
DEV_MFA_CODE=123456
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
